# Copy this file to .env and fill in real values.
# .env is git-ignored and must never be committed.

# development | staging | production | test
NODE_ENV=development
PORT=3000

# MongoDB Atlas connection string.
# Local fallback used automatically if left empty during development:
# mongodb://127.0.0.1:27017/sportxhub
MONGODB_URI=

# JWT secrets — required by Phase 1 (Auth). Generate strong random values,
# e.g. `openssl rand -hex 64`.
JWT_SECRET=
JWT_REFRESH_SECRET=

# Cloudinary — required by Phase 2 (Player media uploads).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Phase 4 — used only by `npm run seed:admin`, which upserts one ADMIN
# account. Not read by the running server; ADMIN accounts cannot be
# created via /auth/register.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Comma-separated list of allowed frontend origins, e.g.
# https://app.sportxhub.com,https://sportxhub.com
# Required when NODE_ENV=production or staging (wildcard "*" is rejected).
# Left empty in development/test, CORS falls back to reflecting the
# request origin for local convenience.
CORS_ORIGINS=

# --- Password reset email (Phase 0.5) ---
# MAIL_PROVIDER selects how AuthService's password-reset email is sent:
#   smtp    — real email via Nodemailer/SMTP (allowed in production/staging)
#   brevo   — real email via Brevo's HTTPS API on 443. Use this on any host
#             that blocks outbound SMTP ports (Railway's trial plan blocks
#             25/465/587/2525 alike, where smtp fails with a connection
#             timeout no credential change can fix)
#   console — logs that an email *would* be sent, without the token, and
#             sends nothing (only allowed outside production/staging)
MAIL_PROVIDER=console

# Required when MAIL_PROVIDER=brevo. From Brevo → SMTP & API → API Settings
# (this is the API key, not the SMTP key).
BREVO_API_KEY=

# Required when MAIL_PROVIDER=smtp.
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (port 465), false for STARTTLS (port 587).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Sender for outgoing mail, e.g. "Sport X Hub <no-reply@sportxhub.com>".
# Required for BOTH smtp and brevo — with brevo the address it names must be
# a verified sender on the Brevo account, or the send is rejected.
SMTP_FROM=

# Base URL of the deployed frontend, used to build the password-reset link
# embedded in the email, e.g. https://app.sportxhub.com
FRONTEND_URL=
