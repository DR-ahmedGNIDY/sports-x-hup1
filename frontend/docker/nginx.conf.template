server {
    # Railway injects $PORT at runtime — docker-entrypoint.sh substitutes it
    # into this template before nginx starts. Defaults to 80 for local
    # `docker run` without $PORT set.
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Single-page app: unknown paths fall back to index.html so client-side
    # routing (go_router) handles them, instead of nginx 404ing.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # The runtime-generated .env asset must never be cached by the browser —
    # it's rewritten on every container start (see docker-entrypoint.sh).
    location = /assets/.env {
        add_header Cache-Control "no-store";
    }
}
