# Sport X Hub — self-hosted stack configuration.
#
# Copy to `.env` **next to docker-compose.yml** and fill in real values:
#
#     cp .env.example .env
#
# `.env` is git-ignored and must never be committed. docker compose reads
# this file for two different jobs: substituting ${...} inside
# docker-compose.yml, and handing the whole set to the API container.
#
# This is separate from backend/.env.example, which documents every variable
# the API understands for a *local* run. This file is the subset a
# production deploy actually sets, plus the two Mongo credentials that only
# the compose stack needs.

# ---------------------------------------------------------------- runtime
NODE_ENV=production
PORT=3000

# ---------------------------------------------------------------- database
# Credentials for the mongo container. Generate, do not invent:
#     openssl rand -hex 24
MONGO_ROOT_USERNAME=sportxhup
MONGO_ROOT_PASSWORD=

# `mongo` is the compose service name, resolved on the internal network —
# the database publishes no port to the host at all. `authSource=admin`
# because that is where MONGO_INITDB_ROOT_* creates the user.
# Must match the two values above.
MONGODB_URI=mongodb://sportxhup:CHANGE_ME@mongo:27017/sportxhub?authSource=admin

# ---------------------------------------------------------------- secrets
# Generate each separately — reusing one value for both means a leaked
# access token is also a refresh token:
#     openssl rand -hex 64
JWT_SECRET=
JWT_REFRESH_SECRET=

# ---------------------------------------------------------------- uploads
# Cloudinary hosts profile photos, club logos and player video.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------- origins
# The browser origins allowed to call the API. A wildcard is rejected when
# NODE_ENV=production. No trailing slash, and `www` is a separate origin —
# omitting it means the app breaks for anyone who typed the www form.
CORS_ORIGINS=https://sportxhup.com,https://www.sportxhup.com

# Used to build the password-reset link inside the email.
FRONTEND_URL=https://sportxhup.com

# ------------------------------------------------------------------- mail
# smtp | brevo | console. `console` sends nothing and only logs that an
# email would have been sent — fine for a first boot, not for real users
# who need to reset a password.
MAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Both providers need this. e.g. "Sport X Hub <no-reply@sportxhup.com>"
SMTP_FROM=
# Only when MAIL_PROVIDER=brevo.
BREVO_API_KEY=

# ------------------------------------------------------------------- push
# Optional. Without these, Web Push disables itself and in-app notifications
# carry on unaffected — see docs/NOTIFICATIONS_PLAN.md section 12.
#
# Generate ONCE and keep them: rotating invalidates every existing
# subscription and every user has to re-enable notifications.
#     npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@sportxhup.com

# ------------------------------------------------------------------ admin
# Read only by `npm run seed:admin`, never by the running server. ADMIN
# accounts cannot be created through /auth/register.
ADMIN_EMAIL=
ADMIN_PASSWORD=
